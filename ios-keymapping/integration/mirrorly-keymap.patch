+    // ---- keymap (ios-keymapping) ------------------------------------------
+    // Everything below is reached only when `--keymap` was given.
+
+    /// Read, parse and validate a profile file.
+    fn keymap_load(path: &std::path::Path) -> Result<keymap::Engine, String> {
+        let text = std::fs::read_to_string(path).map_err(|e| format!("cannot read {}: {e}", path.display()))?;
+        let profile = keymap::Profile::from_json(&text).map_err(|e| e.to_string())?;
+        keymap::Engine::new(profile).map_err(|e| e.to_string())
+    }
+
+    /// Load the profile once at startup; a failure is reported but not fatal.
+    fn keymap_startup_load(&mut self) {
+        let Some(path) = self.keymap.as_ref().map(|k| k.path.clone()) else { return };
+        match Self::keymap_load(&path) {
+            Ok(engine) => {
+                tracing::info!("keymap profile loaded: {}", path.display());
+                if let Some(k) = self.keymap.as_mut() {
+                    k.engine = Some(engine);
+                }
+            }
+            Err(msg) => {
+                tracing::error!("keymap profile {}: {msg}", path.display());
+                self.toast(format!("Keymap profile error: {msg}"), 8.0);
+            }
+        }
+    }
+
+    fn keymap_active(&self) -> bool {
+        self.keymap.as_ref().and_then(|k| k.engine.as_ref()).is_some_and(|e| e.is_active())
+    }
+
+    /// The picture as the engine sees it: the phone's portrait panel and how
+    /// the window turns it.
+    fn keymap_view(&self) -> keymap::View {
+        let v = self.shared.view.lock().unwrap();
+        let rotation = match v.rotation {
+            input::geom::Rotation::R0 => keymap::Rotation::R0,
+            input::geom::Rotation::R90 => keymap::Rotation::R90,
+            input::geom::Rotation::R180 => keymap::Rotation::R180,
+            input::geom::Rotation::R270 => keymap::Rotation::R270,
+        };
+        keymap::View::from_panel(v.screen.0 as f64, v.screen.1 as f64, rotation)
+    }
+
+    fn keymap_send(&self, frames: &[keymap::Frame]) {
+        for f in frames {
+            self.send(HidEvent::MultiTouch(*f));
+        }
+    }
+
+    /// Tell the engine the screen size / rotation (it lifts its fingers when
+    /// they changed, and leaves active mode if the orientation no longer fits).
+    fn keymap_sync_view(&mut self) {
+        if self.keymap.is_none() {
+            return;
+        }
+        let view = self.keymap_view();
+        let (frames, was_active, now_active) = match self.keymap.as_mut().and_then(|k| k.engine.as_mut()) {
+            Some(e) => {
+                let was = e.is_active();
+                let frames = e.set_view(view);
+                (frames, was, e.is_active())
+            }
+            None => return,
+        };
+        self.keymap_send(&frames);
+        if was_active && !now_active {
+            self.keymap_after_stop();
+            self.toast("Keymap off: the picture changed", 4.0);
+        }
+    }
+
+    /// Leave active mode (idempotent): lift every keymap finger.
+    fn keymap_stop(&mut self) {
+        let (frame, was_active) = match self.keymap.as_mut().and_then(|k| k.engine.as_mut()) {
+            Some(e) => {
+                let was = e.is_active();
+                (e.deactivate(), was)
+            }
+            None => return,
+        };
+        if let Some(f) = frame {
+            self.send(HidEvent::MultiTouch(f));
+        }
+        if was_active {
+            self.keymap_after_stop();
+        }
+    }
+
+    /// Give the cursor back after active mode.
+    fn keymap_after_stop(&mut self) {
+        if let Some(k) = self.keymap.as_mut() {
+            k.motion = (0.0, 0.0);
+        }
+        let was_grabbed = self.keymap.as_mut().is_some_and(|k| std::mem::take(&mut k.grabbed));
+        if was_grabbed && let Some(w) = &self.window {
+            let _ = w.set_cursor_grab(winit::window::CursorGrabMode::None);
+            w.set_cursor_visible(true);
+        }
+        self.set_title();
+        self.update_hover();
+    }
+
+    /// Checks before the toggle key may switch the keymap on. Reloads the
+    /// profile file so edits made in the editor apply without a restart.
+    /// Returns false (after a toast) if it must not activate.
+    fn keymap_gate(&mut self) -> bool {
+        let disconnected = self.shared.chrome.lock().unwrap().disconnected;
+        if self.link.is_none() || disconnected {
+            self.toast("Keymap: connect your iPhone first", 3.0);
+            return false;
+        }
+        if self.link == Some("Wi-Fi") && std::env::var_os("MIRROR_KEYMAP_WIFI").is_none() {
+            self.toast("Keymap needs a USB connection (iOS ignores multi-touch over Wi-Fi)", 5.0);
+            return false;
+        }
+        if self.display.is_some() {
+            self.toast("Keymap is not available while the iPad display is on", 4.0);
+            return false;
+        }
+        if Instant::now() < self.scroll_busy_until {
+            self.toast("Keymap: wait a moment, a scroll is still running", 2.0);
+            return false;
+        }
+        if Instant::now() < self.probe_busy_until {
+            self.toast("Keymap: wait a moment, the latency probe is still running", 3.0);
+            return false;
+        }
+        let Some(path) = self.keymap.as_ref().map(|k| k.path.clone()) else { return false };
+        match Self::keymap_load(&path) {
+            Ok(engine) => {
+                if let Some(k) = self.keymap.as_mut() {
+                    k.engine = Some(engine);
+                }
+            }
+            Err(msg) => {
+                tracing::error!("keymap profile {}: {msg}", path.display());
+                self.toast(format!("Keymap profile error: {msg}"), 8.0);
+                return false;
+            }
+        }
+        // Mirrorly's own finger and phone keys must not be held while the
+        // keymap uses the touchscreen.
+        self.release_all();
+        self.keymap_sync_view();
+        true
+    }
+
+    /// A keyboard key (winit `KeyCode` Debug name). Returns true if the
+    /// keymap used it and the normal key handling must not see it.
+    fn keymap_key(&mut self, name: &str, down: bool) -> bool {
+        if self.keymap.is_none() {
+            return false;
+        }
+        if down && !self.keymap_active() {
+            // Without a loaded profile the default toggle key retries the load.
+            let toggle = match self.keymap.as_ref().and_then(|k| k.engine.as_ref()) {
+                Some(e) => e.profile().toggle_key.clone(),
+                None => "Backquote".to_string(),
+            };
+            if name == toggle {
+                if !self.keymap_gate() {
+                    return true;
+                }
+                let loaded_toggle = self
+                    .keymap
+                    .as_ref()
+                    .and_then(|k| k.engine.as_ref())
+                    .map(|e| e.profile().toggle_key.clone())
+                    .unwrap_or_default();
+                if loaded_toggle != name {
+                    self.set_title();
+                    self.toast(format!("Keymap profile loaded: press {loaded_toggle} to start"), 4.0);
+                    return true;
+                }
+            }
+        }
+        let input = if down { keymap::Input::Press(name) } else { keymap::Input::Release(name) };
+        self.keymap_input(input)
+    }
+
+    /// Feed one input to the engine, send its frames, react to its event.
+    /// Returns whether the engine consumed the input.
+    fn keymap_input(&mut self, input: keymap::Input<'_>) -> bool {
+        let now_ms = now_us() / 1000;
+        let (out, has_look, toggle, panic_key) = match self.keymap.as_mut().and_then(|k| k.engine.as_mut()) {
+            Some(e) => {
+                let out = e.handle(input, now_ms);
+                let p = e.profile();
+                (out, p.has_look(), p.toggle_key.clone(), p.panic_key.clone())
+            }
+            None => return false,
+        };
+        self.keymap_send(&out.frames);
+        match out.event {
+            Some(keymap::EngineEvent::Activated) => {
+                if has_look && let Some(w) = &self.window {
+                    // Windows supports Confined, not Locked; raw mouse motion
+                    // keeps arriving through `device_event` either way.
+                    if let Err(e) = w.set_cursor_grab(winit::window::CursorGrabMode::Confined) {
+                        tracing::warn!("keymap: cannot confine the cursor: {e}");
+                    }
+                    w.set_cursor_visible(false);
+                    if let Some(k) = self.keymap.as_mut() {
+                        k.grabbed = true;
+                    }
+                }
+                self.set_bar(false);
+                self.set_title();
+                self.toast(format!("Keymap on: {toggle} to leave, {panic_key} to stop"), 4.0);
+            }
+            Some(keymap::EngineEvent::Deactivated) => {
+                self.keymap_after_stop();
+                self.toast("Keymap off", 2.0);
+            }
+            Some(keymap::EngineEvent::Panic) => {
+                self.keymap_after_stop();
+                self.toast("Keymap stopped (panic key)", 3.0);
+            }
+            Some(keymap::EngineEvent::ActivateFailed(msg)) => {
+                self.toast(format!("Keymap: {msg}"), 5.0);
+            }
+            None => {}
+        }
+        out.consumed
+    }
+
+    /// Deliver the gathered raw mouse motion as one engine input.
+    fn keymap_flush_motion(&mut self) {
+        let Some(k) = self.keymap.as_mut() else { return };
+        let (dx, dy) = std::mem::take(&mut k.motion);
+        if (dx != 0.0 || dy != 0.0) && self.keymap_active() {
+            self.keymap_input(keymap::Input::MouseMotion { dx, dy });
+        }
+    }
+
+    /// Run the engine's timers (tap lifts, look idle lift). Returns when it
+    /// next wants to be woken.
+    fn keymap_tick(&mut self) -> Option<Instant> {
+        let now_ms = now_us() / 1000;
+        let (frames, deadline) = {
+            let e = self.keymap.as_mut()?.engine.as_mut()?;
+            let frames = e.tick(now_ms);
+            (frames, e.next_deadline())
+        };
+        self.keymap_send(&frames);
+        deadline.map(|d| epoch().instant + Duration::from_millis(d))
+    }
