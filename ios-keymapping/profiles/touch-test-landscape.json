{
  "version": 1,
  "name": "Touch test (landscape)",
  "app": "multi-touch test app",
  "orientation": "landscape",
  "toggle_key": "Backquote",
  "panic_key": "F8",
  "controls": [
    { "type": "joystick", "label": "Move", "x": 0.15, "y": 0.7, "radius": 0.15, "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" },
    { "type": "look", "label": "Look", "x": 0.65, "y": 0.45, "sensitivity": 1.0, "invert_y": false, "reach": 0.25, "release_after_ms": 0 },
    { "type": "button", "label": "Hold A", "x": 0.88, "y": 0.75, "key": "Space", "mode": "hold" },
    { "type": "button", "label": "Hold B", "x": 0.78, "y": 0.88, "key": "MouseLeft", "mode": "hold" },
    { "type": "button", "label": "Tap C", "x": 0.92, "y": 0.55, "key": "KeyJ", "mode": "tap" },
    { "type": "button", "label": "Tap D", "x": 0.4, "y": 0.85, "key": "KeyK", "mode": "tap" }
  ]
}
