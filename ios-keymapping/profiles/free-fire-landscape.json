{
  "version": 1,
  "name": "Free Fire (landscape)",
  "app": "Free Fire MAX",
  "orientation": "landscape",
  "toggle_key": "CapsLock",
  "panic_key": "Escape",
  "controls": [
    { "type": "joystick", "label": "Move", "x": 0.189, "y": 0.75, "radius": 0.12, "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD", "sprint_key": "ShiftLeft", "sprint_radius": 0.22 },
    { "type": "look", "label": "Look", "x": 0.58, "y": 0.55, "sensitivity": 0.4, "invert_y": false, "reach": 0.45, "release_after_ms": 0 },
    { "type": "button", "label": "Fire", "x": 0.787, "y": 0.923, "key": "MouseLeft", "mode": "hold" },
    { "type": "button", "label": "Scope", "x": 0.268, "y": 0.422, "key": "MouseRight", "mode": "tap" },
    { "type": "button", "label": "Jump", "x": 0.897, "y": 0.926, "key": "Space", "mode": "tap" },
    { "type": "button", "label": "Crouch", "x": 0.845, "y": 0.926, "key": "KeyC", "mode": "tap" },
    { "type": "button", "label": "Prone", "x": 0.951, "y": 0.926, "key": "KeyZ", "mode": "tap" },
    { "type": "button", "label": "Reload", "x": 0.954, "y": 0.8, "key": "KeyR", "mode": "tap" },
    { "type": "button", "label": "Grenade", "x": 0.201, "y": 0.412, "key": "KeyG", "mode": "tap" },
    { "type": "button", "label": "Medkit", "x": 0.648, "y": 0.628, "key": "KeyH", "mode": "tap" },
    { "type": "button", "label": "Weapon 1", "x": 0.841, "y": 0.307, "key": "Digit1", "mode": "tap" },
    { "type": "button", "label": "Weapon 2", "x": 0.892, "y": 0.307, "key": "Digit2", "mode": "tap" }
  ]
}
