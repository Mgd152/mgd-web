{
  "version": 1,
  "name": "Touch test (portrait)",
  "app": "multi-touch test app",
  "orientation": "portrait",
  "toggle_key": "Backquote",
  "panic_key": "F8",
  "controls": [
    { "type": "joystick", "label": "Move", "x": 0.25, "y": 0.75, "radius": 0.12, "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" },
    { "type": "look", "label": "Look", "x": 0.7, "y": 0.45, "sensitivity": 1.0, "invert_y": false, "reach": 0.25, "release_after_ms": 0 },
    { "type": "button", "label": "Hold A", "x": 0.82, "y": 0.8, "key": "Space", "mode": "hold" },
    { "type": "button", "label": "Hold B", "x": 0.68, "y": 0.88, "key": "MouseLeft", "mode": "hold" },
    { "type": "button", "label": "Hold C", "x": 0.55, "y": 0.62, "key": "KeyK", "mode": "hold" },
    { "type": "button", "label": "Tap D", "x": 0.88, "y": 0.65, "key": "KeyJ", "mode": "tap" }
  ]
}
